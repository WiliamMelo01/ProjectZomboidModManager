+            continue;
+        }
+
+        if let Some(workshop_id) = line
+            .split(|char: char| !char.is_ascii_digit())
+            .find(|value| wanted.contains(*value))
+        {
+            completed.insert(workshop_id.to_string());
+        }
+    }
+
